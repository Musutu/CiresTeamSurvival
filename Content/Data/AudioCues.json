{
  "schemaVersion": 1,
  "notes": "Named one-shot / loop cues for CireAudio::PlayCue, PlayCue2D and PlayAttached. Sound names resolve to /Game/Audio/<Folder>/<Name>; {01..04} expands to a numbered set and one member is picked at random (never the same twice in a row). volume is linear before the bus volume; pitch and volumeJitter randomise every play; cooldown drops repeats of the same cue within that many seconds. Bus routing, attenuation and concurrency come from the imported SoundWave (Tools/BuildAudioContent.py). See Docs/Audio.md.",
  "cues": {
    "ui_click":           { "sounds": ["UI/UI_Click_{01..03}"], "volume": 0.55, "pitch": [0.97, 1.04], "cooldown": 0.04 },
    "ui_hover":           { "sounds": ["UI/UI_Hover_{01..04}"], "volume": 0.35, "pitch": [0.98, 1.05], "cooldown": 0.06 },
    "ui_open":            { "sounds": ["UI/UI_Open"], "volume": 0.5, "cooldown": 0.1 },
    "ui_close":           { "sounds": ["UI/UI_Close"], "volume": 0.5, "cooldown": 0.1 },
    "ui_confirm":         { "sounds": ["UI/UI_Confirm"], "volume": 0.5, "cooldown": 0.1 },

    "level_up":           { "sounds": ["SFX/SFX_LevelUp"], "volume": 0.75, "cooldown": 1.0 },
