{
  "schemaVersion": 1,
  "_comment": "progression-shop: challenge-pack gating and bonus-drop tables (design proposal). Chances are per entry and independent; gold/XP grow +25% per tier above 1, chances +8% relative per tier, then x team loot bonus. See Docs/Progression.md. Gold entries are multiplied by the current mob value (economy.lootGoldInMobValues). monster-expansion: sources.rareSpawn / sources.bonusWave are the personal chests of Rare Spawns and Bonus Loot Wave creatures (Docs/MonsterExpansion.md).",
  "scaling": {
    "goldPerTier": 0.25,
    "chancePerTier": 0.08,
    "maxChance": 0.95
  },
  "packSchedule": {
    "_comment": "Bay 1 is nearest town; deeper bays sit toward the monster spawn. A bay's tier = bay number, +1 at promotionStartRound and +1 every promotionEveryRounds after.",
    "bays": [
      {
        "bay": 1,
        "unlockRound": 1,
        "unlockWave": 1
      },
      {
        "bay": 2,
        "unlockRound": 2,
        "unlockWave": 1
      },
      {
        "bay": 3,
        "unlockRound": 3,
        "unlockWave": 2
      }
    ],
    "promotionStartRound": 4,
    "promotionEveryRounds": 2,
    "maxTier": 8
  },
  "pickup": {
    "radius": 320,
    "autoCollectOnPrep": true
  },
  "economy": {
    "_comment": "Eric's ruling (playtest 2). Gold per kill = mobValue x multiplier, mobValue = mobBase + mobStep x floor(globalWave / stepEveryWaves) (1 gold at the start, wave 6 = 3). Wave kills pay EVERY teammate the full value (shared lane bounty); challenge-pack units and Pack Leaders pay every eligible teammate (damaged the pack or alive within distribution.eligibleRadius). Loot-table gold amounts are in mob values too.",
    "mobBase": 1,
    "mobStep": 1,
    "stepEveryWaves": 3,
    "armoredMultiplier": 2,
    "bossMultiplier": 10,
    "packUnitMultiplier": 10,
    "packLeaderMultiplier": 100,
    "lootGoldInMobValues": true
  },
  "distribution": {
    "_comment": "personal (default): every eligible teammate rolls every table independently and gets a chest only they can see/open. Eligible = damaged the pack/boss, or alive within eligibleRadius cm of the kill. Gold/XP entries keep their full chance per player; tome/item chances are multiplied by personalItemFactor / eligiblePlayers so the team's expected tomes+items equal the old single shared roll. Bots auto-loot. teamRotation = the previous shared chest with lowest-loot-score rotation.",
    "mode": "personal",
    "eligibleRadius": 4000,
    "personalItemFactor": 1.0,
    "botsAutoLoot": true
  },
  "sources": {
    "packCompletion": [
      {
        "minTier": 1,
