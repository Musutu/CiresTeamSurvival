# Unreal build output and caches (any depth: game, plugins, builder projects)
Binaries/
Intermediate/
Saved/
DerivedDataCache/
.vs/
.vscode/
*.sln
*.pdb
*.ilk
*.exp
__pycache__/
*.pyc

# Native rules test build output
Tests/build/

# Compiler objects in source trees (art .obj meshes under Art/ are kept)
Source/**/*.obj
Source/**/*.lib

# Browser download scratch
Art/Downloads/

# Local-only
*.log
.env

# Fab import staging (isolated ContentBuilder output; results are copied to Content/Fab)
Tools/ContentBuilder/Content/Fab/

# Fab / Epic-licensed content: licensed for use, not redistribution. Kept local only (repo is public).
Content/Fab/

# ---- Purchased Fab packs (Docs/FAB-PURCHASED.md) ----------------------------
# Paid, licensed Unreal packs. "Add to Project" puts each one at Content/<PackFolder>
# in the MAIN checkout; Tools/LinkFabContent.py junctions them into every worktree
# and also lists them in .git/info/exclude. NEVER commit these (public repo).
# No trailing slash: in a worktree the folder is a junction, not a directory.
# (pack folders are appended below as each pack lands)
# Derived from licensed Fab packs (retargeted clips, IK rigs): same rule, never commit.
Content/FabDerived
Content/Big_Pack_Magic_VFX
Content/Shadow_Magic
Content/CastleTown
Content/CrossbowPackAnim
Content/Earth_Spells
Content/Forest_VFX
Content/FXVarietyPack
Content/GDHBundle
Content/Gun_and_Sword
Content/MaleLocomotionSet
Content/Medieval_Weapons
Content/Medieval_Weapons_VOL2
Content/Monster
Content/Polyphoria
Content/QuadrapedCreatures
Content/RealisticBlood
Content/ROG_Creatures
Content/State_VFX
Content/UndeadPack
# World-partition external actors/objects of pack demo maps (e.g. the audio packs): local only, never tracked.
Content/__ExternalActors__
Content/__ExternalObjects__
# audio packs (feat/audio-overhaul, Docs/Audio.md "Fab audio packs"; mapped by Tools/MapFabAudio.py)
Content/ShieldBlocksDeflects
Content/Professional_Gunshots
Content/Magic_Spell_SFX_Pack_Vol1
Content/Combat_Sounds_-_Lite
Content/Fantasy_UI_SFX_Pack
# the gunshot pack's demo map writes One File Per Actor data here
Content/__ExternalActors__/Professional_Gunshots
Content/__ExternalObjects__/Professional_Gunshots
